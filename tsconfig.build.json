{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // Vite (library mode) emits the .js; tsc only emits the type declarations.
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.test.tsx", "vitest.config.ts"]
}
