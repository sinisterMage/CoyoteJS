{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "@sinistermage/coyote-js",
    "strict": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@sinistermage/coyote-js/jsx-runtime": ["./src/dom/jsx-runtime.ts"],
      "@sinistermage/coyote-js/jsx-dev-runtime": ["./src/dom/jsx-runtime.ts"],
      "@sinistermage/coyote-js": ["./src/index.ts"],
      "@sinistermage/coyote-js/*": ["./src/*"]
    }
  },
  "include": ["src", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
